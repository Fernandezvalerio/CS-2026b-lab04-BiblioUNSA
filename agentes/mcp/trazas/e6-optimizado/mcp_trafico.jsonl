O no devueltos, con vencimiento anterior a hoy (AAAA-MM-DD real). Retorna total y hasta 20 registros con días de atraso; sin datos personales ni cambios.", "inputSchema": {"type": "object", "properties": {"hoy": {"title": "Hoy", "type": "string"}}, "required": ["hoy"], "title": "prestamos_vencidosArguments"}, "name": "prestamos_vencidos", "outputSchema": {"$defs": {"PrestamoSalida": {"properties": {"prestamo_id": {"title": "Prestamo Id", "type": "string"}, "ejemplar_id": {"title": "Ejemplar Id", "type": "string"}, "codigo_inventario": {"title": "Codigo Inventario", "type": "string"}, "biblioteca": {"title": "Biblioteca", "type": "string"}, "estado": {"title": "Estado", "type": "string"}, "fecha_vencimiento": {"title": "Fecha Vencimiento", "type": "string"}, "dias_atraso": {"title": "Dias Atraso", "type": "integer"}}, "required": ["prestamo_id", "ejemplar_id", "codigo_inventario", "biblioteca", "estado", "fecha_vencimiento", "dias_atraso"], "title": "PrestamoSalida", "type": "object"}}, "properties": {"fecha_corte": {"title": "Fecha Corte", "type": "string"}, "total": {"title": "Total", "type": "integer"}, "prestamos": {"items": {"$ref": "#/$defs/PrestamoSalida"}, "title": "Prestamos", "type": "array"}}, "required": ["fecha_corte", "total", "prestamos"], "title": "VencidosSalida", "type": "object"}, "title": "Consultar préstamos vencidos"}, {"annotations": {"destructiveHint": false, "idempotentHint": false, "openWorldHint": false, "readOnlyHint": false}, "description": "Crea RESERVADO en memoria; exige aprobación humana del host. estudiante_id: UUID de alumno ficticio vigente (00000000-0000-4000-8000-000000000001); ejemplar_id: UUID disponible de buscar_libro. Retorna UUID, estado, fecha ISO 8601 y reverificación; no edita/borra préstamos.", "inputSchema": {"type": "object", "properties": {"estudiante_id": {"title": "Estudiante Id", "type": "string"}, "ejemplar_id": {"title": "Ejemplar Id", "type": "string"}}, "required": ["estudiante_id", "ejemplar_id"], "title": "crear_reservaArguments"}, "name": "crear_reserva", "outputSchema": {"properties": {"reserva_id": {"title": "Reserva Id", "type": "string"}, "estudiante_id": {"title": "Estudiante Id", "type": "string"}, "ejemplar_id": {"title": "Ejemplar Id", "type": "string"}, "estado": {"title": "Estado", "type": "string"}, "fecha_reserva": {"title": "Fecha Reserva", "type": "string"}, "requiere_reverificacion": {"title": "Requiere Reverificacion", "type": "boolean"}}, "required": ["reserva_id", "estudiante_id", "ejemplar_id", "estado", "fecha_reserva", "requiere_reverificacion"], "title": "ReservaSalida", "type": "object"}, "title": "Crear reserva de prueba"}], "ttlMs": 0, "_meta": {"io.modelcontextprotocol/serverInfo": {"name": "bibliounsa", "version": ""}}}}}
