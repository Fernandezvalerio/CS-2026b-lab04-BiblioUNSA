@startuml
title <size:24>Component View: BiblioUNSA - Monolito modular BiblioUNSA</size>\n<size:24>Nivel 3: módulos del monolito modular.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Software System,Externo", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Component", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Queue", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Container", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid")

System(SistemaacadémicoUNSA, "Sistema académico UNSA", $descr="Informa si la matrícula del estudiante está vigente.", $tags="Software System,Externo", $link="")
System(Proveedordeidentidad, "Proveedor de identidad", $descr="Autentica con el correo institucional de la UNSA.", $tags="Software System,Externo", $link="")

System_Boundary("BiblioUNSA_boundary", "BiblioUNSA", $tags="Software System") {
  Container_Boundary("BiblioUNSA.MonolitomodularBiblioUNSA_boundary", "Monolito modular BiblioUNSA", $tags="Container") {
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloMultas, "Módulo Multas", $techn="Django app", $descr="Calcula y controla las multas por devolución tardía.", $tags="Component", $link="")
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloIntegraciónacadémica, "Módulo Integración académica", $techn="Django app", $descr="Único punto de contacto con el sistema académico: adaptador con timeout de 3 s y caché de ≤ 24 h.", $tags="Component", $link="")
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, "Módulo Autenticación y acceso", $techn="Django app", $descr="Inicia sesión con el correo institucional y rechaza y registra los intentos con correos ajenos a la UNSA.", $tags="Component", $link="")
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloCatálogo, "Módulo Catálogo", $techn="Django app", $descr="Busca libros y gestiona la disponibilidad de los ejemplares.", $tags="Component", $link="")
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, "Módulo Reservas", $techn="Django app", $descr="Reserva libros validando la matrícula vigente y reverifica las validaciones hechas con caché.", $tags="Component", $link="")
    Component(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, "Módulo Préstamos y devoluciones", $techn="Django app", $descr="Registra la entrega y la devolución con carné QR y controla el ciclo de vida del préstamo.", $tags="Component", $link="")
  }

  ContainerDb(BiblioUNSA.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, catálogo, préstamos y multas (un esquema por módulo).", $tags="Container,Database", $link="")
  ContainerQueue(BiblioUNSA.Cachéycoladetareas, "Caché y cola de tareas", $techn="Redis", $descr="Guarda la última validación de matrícula y las tareas de reverificación.", $tags="Container,Queue", $link="")
  Container(BiblioUNSA.Workerdereverificación, "Worker de reverificación", $techn="Celery", $descr="Reverifica en ≤ 30 min las matrículas validadas con caché.", $tags="Container", $link="")
  Container(BiblioUNSA.Interfazwebresponsive, "Interfaz web responsive", $techn="HTML + JavaScript", $descr="Interfaz para estudiantes (celular) y bibliotecarios (PC con lector QR).", $tags="Container,Web Browser", $link="")
}

Rel(BiblioUNSA.Workerdereverificación, BiblioUNSA.Cachéycoladetareas, "Consume tareas", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, "Inicia sesión", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloCatálogo, "Consulta el catálogo", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, "Reserva libros", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, "Registra préstamos y devoluciones", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloMultas, "Consulta y cobra multas", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloIntegraciónacadémica, "Valida la matrícula vigente", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloCatálogo, "Reserva el ejemplar", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, "Crea el préstamo en estado RESERVADO", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, "Identifica al estudiante", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloCatálogo, "Libera el ejemplar al devolverlo", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, "Identifica al estudiante", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloMultas, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, "Aplica la multa al préstamo", $techn="Llamada interna (Python)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, Proveedordeidentidad, "Verifica identidad y dominio", $techn="OpenID Connect", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloIntegraciónacadémica, SistemaacadémicoUNSA, "Consulta la matrícula (timeout 3 s)", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloIntegraciónacadémica, BiblioUNSA.Cachéycoladetareas, "Lee y guarda la caché de matrícula (≤ 24 h)", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, BiblioUNSA.Cachéycoladetareas, "Encola la reverificación", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloAutenticaciónyacceso, BiblioUNSA.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloCatálogo, BiblioUNSA.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloPréstamosydevoluciones, BiblioUNSA.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA.MóduloMultas, BiblioUNSA.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(BiblioUNSA.Workerdereverificación, BiblioUNSA.MonolitomodularBiblioUNSA.MóduloReservas, "Ejecuta reverificarPendientes()", $techn="Tarea Celery", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml