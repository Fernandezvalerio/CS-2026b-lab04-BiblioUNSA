@startuml
title <size:24>Deployment View: BiblioUNSA - Producción</size>\n<size:24>Despliegue en producción (MVP en un solo VPS).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

AddElementTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Queue", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

Deployment_Node(Producción.CelularoPCdelusuario, "Celular o PC del usuario", $type="Android / navegador web", $descr="Estudiante (celular) o bibliotecario (PC con lector QR).", $tags="Element", $link="") {
  Container(Producción.CelularoPCdelusuario.Interfazwebresponsive_1, "Interfaz web responsive", $techn="HTML + JavaScript", $descr="Interfaz para estudiantes (celular) y bibliotecarios (PC con lector QR).", $tags="Container,Web Browser", $link="")
}

Deployment_Node(Producción.ServidorenlanubeVPS, "Servidor en la nube (VPS)", $type="Ubuntu 24.04 · 2 vCPU · 4 GB RAM", $descr="Único servidor del MVP (presupuesto bajo).", $tags="Element", $link="") {
  Deployment_Node(Producción.ServidorenlanubeVPS.DockerCompose, "Docker Compose", $type="Docker", $descr="Orquesta los contenedores en el VPS.", $tags="Element", $link="") {
    Container(Producción.ServidorenlanubeVPS.DockerCompose.MonolitomodularBiblioUNSA_1, "Monolito modular BiblioUNSA", $techn="Python / Django", $descr="Un solo despliegue con seis módulos de dominio; expone la API REST que consume la interfaz web.", $tags="Container", $link="")
    Container(Producción.ServidorenlanubeVPS.DockerCompose.Workerdereverificación_1, "Worker de reverificación", $techn="Celery", $descr="Reverifica en ≤ 30 min las matrículas validadas con caché.", $tags="Container", $link="")
    ContainerDb(Producción.ServidorenlanubeVPS.DockerCompose.Basededatos_1, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, catálogo, préstamos y multas (un esquema por módulo).", $tags="Container,Database", $link="")
    ContainerQueue(Producción.ServidorenlanubeVPS.DockerCompose.Cachéycoladetareas_1, "Caché y cola de tareas", $techn="Redis", $descr="Guarda la última validación de matrícula y las tareas de reverificación.", $tags="Container,Queue", $link="")
  }

}

Rel(Producción.CelularoPCdelusuario.Interfazwebresponsive_1, Producción.ServidorenlanubeVPS.DockerCompose.MonolitomodularBiblioUNSA_1, "Llama a", $techn="HTTPS/JSON (REST)", $tags="Relationship", $link="")
Rel(Producción.ServidorenlanubeVPS.DockerCompose.Workerdereverificación_1, Producción.ServidorenlanubeVPS.DockerCompose.MonolitomodularBiblioUNSA_1, "Ejecuta la reverificación", $techn="Tarea Celery", $tags="Relationship", $link="")
Rel(Producción.ServidorenlanubeVPS.DockerCompose.MonolitomodularBiblioUNSA_1, Producción.ServidorenlanubeVPS.DockerCompose.Basededatos_1, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(Producción.ServidorenlanubeVPS.DockerCompose.MonolitomodularBiblioUNSA_1, Producción.ServidorenlanubeVPS.DockerCompose.Cachéycoladetareas_1, "Lee y guarda la caché y encola tareas", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(Producción.ServidorenlanubeVPS.DockerCompose.Workerdereverificación_1, Producción.ServidorenlanubeVPS.DockerCompose.Cachéycoladetareas_1, "Consume tareas", $techn="Redis protocol", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml