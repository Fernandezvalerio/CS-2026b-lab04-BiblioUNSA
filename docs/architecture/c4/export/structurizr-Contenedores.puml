@startuml
title <size:24>Container View: BiblioUNSA</size>\n<size:24>Nivel 2: contenedores de BiblioUNSA.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Software System,Externo", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Queue", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Estudiante, "Estudiante", $descr="Consulta el catálogo, reserva libros y revisa sus préstamos y multas.", $tags="Person", $link="")
Person(Bibliotecario, "Bibliotecario", $descr="Registra préstamos y devoluciones con el carné QR y controla las multas.", $tags="Person", $link="")
System(SistemaacadémicoUNSA, "Sistema académico UNSA", $descr="Informa si la matrícula del estudiante está vigente.", $tags="Software System,Externo", $link="")
System(Proveedordeidentidad, "Proveedor de identidad", $descr="Autentica con el correo institucional de la UNSA.", $tags="Software System,Externo", $link="")

System_Boundary("BiblioUNSA_boundary", "BiblioUNSA", $tags="Software System") {
  ContainerDb(BiblioUNSA.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, catálogo, préstamos y multas (un esquema por módulo).", $tags="Container,Database", $link="")
  ContainerQueue(BiblioUNSA.Cachéycoladetareas, "Caché y cola de tareas", $techn="Redis", $descr="Guarda la última validación de matrícula y las tareas de reverificación.", $tags="Container,Queue", $link="")
  Container(BiblioUNSA.Workerdereverificación, "Worker de reverificación", $techn="Celery", $descr="Reverifica en ≤ 30 min las matrículas validadas con caché.", $tags="Container", $link="")
  Container(BiblioUNSA.Interfazwebresponsive, "Interfaz web responsive", $techn="HTML + JavaScript", $descr="Interfaz para estudiantes (celular) y bibliotecarios (PC con lector QR).", $tags="Container,Web Browser", $link="")
  Container(BiblioUNSA.MonolitomodularBiblioUNSA, "Monolito modular BiblioUNSA", $techn="Python / Django", $descr="Un solo despliegue con seis módulos de dominio; expone la API REST que consume la interfaz web.", $tags="Container", $link="")
}

Rel(Estudiante, BiblioUNSA.Interfazwebresponsive, "Usa", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Bibliotecario, BiblioUNSA.Interfazwebresponsive, "Usa", $techn="HTTPS", $tags="Relationship", $link="")
Rel(BiblioUNSA.Interfazwebresponsive, BiblioUNSA.MonolitomodularBiblioUNSA, "Llama a", $techn="HTTPS/JSON (REST)", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA, BiblioUNSA.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA, BiblioUNSA.Cachéycoladetareas, "Lee y guarda la caché y encola tareas", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA, SistemaacadémicoUNSA, "Consulta la matrícula vigente", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(BiblioUNSA.MonolitomodularBiblioUNSA, Proveedordeidentidad, "Verifica la identidad institucional", $techn="OpenID Connect", $tags="Relationship", $link="")
Rel(BiblioUNSA.Workerdereverificación, BiblioUNSA.Cachéycoladetareas, "Consume tareas", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(BiblioUNSA.Workerdereverificación, BiblioUNSA.MonolitomodularBiblioUNSA, "Ejecuta la reverificación", $techn="Tarea Celery", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml