{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "historia_id",
    "invest_ok",
    "preguntas",
    "escenarios"
  ],
  "properties": {
    "historia_id": {
      "type": "string",
      "pattern": "^H[1-8]$"
    },
    "invest_ok": {
      "type": "boolean"
    },
    "preguntas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "escenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titulo",
          "tipo",
          "dado",
          "cuando",
          "entonces"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 3
          },
          "tipo": {
            "enum": [
              "exito",
              "error",
              "borde"
            ]
          },
          "dado": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "cuando": {
            "type": "string",
            "minLength": 3
          },
          "entonces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
